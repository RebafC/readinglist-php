{% extends "main.html.twig" %}

{% block content %}
{{ flashmsg|raw }}
<form action="/add" method="post" class="form">
	<fieldset>
		<legend>Add to the {{ title }} list.</legend>

		<div>
			<label for="url">URL</label>
			<input type="text" name="url" value="{{ pageurl }}" required>
		</div>

		<div>
			<label for="title">Title</label>
			<input type="text" name="title" value="{{ pagetitle }}">
		</div>

		
		<div>
			<label for="notes">Notes</label>
			<textarea rows="6" placeholder="Not implemented yet" disabled></textarea>
		</div>

		<button type="submit">Submit</button>
	</fieldset>
</form>
{% endblock%}
{# block content #}
